# Manual Gradle signing only: copy to secrets/keystore.properties (gitignored) next to your keystore file,
# with storeFile pointing at it (resolved relative to secrets/).
# CI and scripts/build-pocketweibo-release.sh write this file automatically.
# CI / secret names: .github/workflows/build-apk.yml, docs/FIX.md

# Generate a keystore once, for example:
#   keytool -genkeypair -v -keystore secrets/release.keystore -alias pocketweibo \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass YOUR_STORE_PASSWORD -keypass YOUR_KEY_PASSWORD \
#     -dname "CN=PocketWeibo"

# GitHub Actions secrets: ANDROID_KEYSTORE_BASE64, KEYSTORE_PASSWORD, KEY_PASSWORD, KEY_ALIAS (docs/FIX.md).

storeFile=release.keystore

storePassword=CHANGE_ME
keyAlias=pocketweibo
keyPassword=CHANGE_ME
