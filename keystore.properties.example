# Manual Gradle signing only: copy to keystore.properties (gitignored) next to your keystore file.
#
# Recommended local release build (matches CI): scripts/build-pocketweibo-release.sh
#   uses github-keystore-secrets.local.txt — see github-keystore-secrets.local.txt.example
#
# CI / secret names: .github/workflows/build-apk.yml, FIX.md
#
# Generate a keystore once, for example:
#   keytool -genkeypair -v -keystore release.keystore -alias pocketweibo \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storepass YOUR_STORE_PASSWORD -keypass YOUR_KEY_PASSWORD \
#     -dname "CN=PocketWeibo, OU=Mobile, O=PocketWeibo, L=NA, ST=NA, C=US"
#
# GitHub Actions secrets: ANDROID_KEYSTORE_BASE64, KEYSTORE_PASSWORD, KEY_PASSWORD, KEY_ALIAS (FIX.md).

storeFile=release.keystore
storePassword=CHANGE_ME
keyAlias=pocketweibo
keyPassword=CHANGE_ME
