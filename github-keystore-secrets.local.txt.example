# Copy to github-keystore-secrets.local.txt at the repo root (that file is gitignored).
# Use the same values as GitHub Actions secrets (.github/workflows/build-apk.yml, FIX.md).
# ANDROID_KEYSTORE_BASE64 must be ONE line (e.g. Linux: base64 -w0 pocket-weibo-release.keystore).

ANDROID_KEYSTORE_BASE64=PASTE_BASE64_OF_KEYSTORE_HERE
KEYSTORE_PASSWORD=YOUR_KEYSTORE_PASSWORD
# KEY_PASSWORD=optional_if_different_from_KEYSTORE_PASSWORD
# KEY_ALIAS=pocketweibo
