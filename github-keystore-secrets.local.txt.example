# Copy to github-keystore-secrets.local.txt at the repo root (gitignored).
# Use the same values as GitHub Actions secrets (.github/workflows/build-apk.yml, FIX.md).
#
# Keystore bytes as base64 (GitHub secret ANDROID_KEYSTORE_BASE64) — pick ONE:
#   A) Put only passwords here; put base64 in a companion file (same prefix, no .txt):
#        github-keystore-secrets.local.ANDROID_KEYSTORE_BASE64
#      (contents: output of base64 -w0 your.keystore; may be multiple lines — newlines stripped)
#   B) ANDROID_KEYSTORE_BASE64_FILE=relative/path/from/repo/root/to/base64-only.txt
#   C) ANDROID_KEYSTORE_BASE64=PASTE_SINGLE_LINE_BASE64_HERE

KEYSTORE_PASSWORD=YOUR_KEYSTORE_PASSWORD
# KEY_PASSWORD=optional_if_different_from_KEYSTORE_PASSWORD
# KEY_ALIAS=pocketweibo
