<?xml version="1.0" encoding="utf-8"?>
<!-- REVIEW-2 §3: private notes are not uploaded to Google cloud backup. Device-to-device transfer
     keeps everything (database, media, settings, encrypted auto-backups). Android 12+. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" />
        <include domain="database" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
